// Helper functions
static inline void CS_LOW(void) {
    HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
}

static inline void CS_HIGH(void) {
    HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
}

// Optimized SPI write with error checking
static MPU9250_Error_t write_reg(uint8_t reg, uint8_t val) {
    if (!spi_h || !cs_port) return MPU9250_ERR_INVALID_PARAM;

    uint8_t tx[2] = {reg & 0x7F, val};  // Clear MSB for write
    HAL_StatusTypeDef status;

    CS_LOW();
    status = HAL_SPI_Transmit(spi_h, tx, 2, MPU9250_SPI_TIMEOUT);
    CS_HIGH();

    return (status == HAL_OK) ? MPU9250_OK : MPU9250_ERR_SPI;
}

// Optimized SPI read with burst capability
static MPU9250_Error_t read_regs(uint8_t reg, uint8_t *buf, uint16_t len) {
    if (!spi_h || !cs_port || !buf || len == 0) return MPU9250_ERR_INVALID_PARAM;

    uint8_t tx = reg | 0x80;  // Set MSB for read
    HAL_StatusTypeDef status;

    CS_LOW();
    status = HAL_SPI_Transmit(spi_h, &tx, 1, MPU9250_SPI_TIMEOUT);
    if (status == HAL_OK) {
        status = HAL_SPI_Receive(spi_h, buf, len, MPU9250_SPI_TIMEOUT);
    }
    CS_HIGH();

    return (status == HAL_OK) ? MPU9250_OK : MPU9250_ERR_SPI;
}

// DMA-based SPI read for high-speed operation (optional)
static MPU9250_Error_t read_regs_dma(uint8_t reg, uint8_t *buf, uint16_t len) {
    if (!spi_h || !cs_port || !buf || len == 0) return MPU9250_ERR_INVALID_PARAM;

    uint8_t tx = reg | 0x80;
    HAL_StatusTypeDef status;

    CS_LOW();
    status = HAL_SPI_Transmit(spi_h, &tx, 1, MPU9250_SPI_TIMEOUT);
    if (status == HAL_OK) {
        status = HAL_SPI_Receive_DMA(spi_h, buf, len);
        // Note: You need to handle DMA completion callback
    }

    return (status == HAL_OK) ? MPU9250_OK : MPU9250_ERR_SPI;
}

// AK8963 I2C communication through MPU9250's auxiliary I2C
static MPU9250_Error_t write_ak8963(uint8_t reg, uint8_t val) {
    MPU9250_Error_t result;

    // Set up I2C slave 0 for write
    result = write_reg(MPU9250_REG_I2C_SLV0_ADDR, AK8963_I2C_ADDR);
    if (result != MPU9250_OK) return result;

    result = write_reg(MPU9250_REG_I2C_SLV0_REG, reg);
    if (result != MPU9250_OK) return result;

    result = write_reg(MPU9250_REG_I2C_SLV0_DO, val);
    if (result != MPU9250_OK) return result;

    result = write_reg(MPU9250_REG_I2C_SLV0_CTRL, 0x81);  // Enable and write 1 byte
    if (result != MPU9250_OK) return result;

    HAL_Delay(10);  // Wait for I2C transaction
    return MPU9250_OK;
}

static MPU9250_Error_t read_ak8963(uint8_t reg, uint8_t *buf, uint16_t len) {
    if (!buf || len == 0) return MPU9250_ERR_INVALID_PARAM;

    MPU9250_Error_t result;

    // Set up I2C slave 0 for read
    result = write_reg(MPU9250_REG_I2C_SLV0_ADDR, AK8963_I2C_ADDR | 0x80);  // Read bit
    if (result != MPU9250_OK) return result;

    result = write_reg(MPU9250_REG_I2C_SLV0_REG, reg);
    if (result != MPU9250_OK) return result;

    result = write_reg(MPU9250_REG_I2C_SLV0_CTRL, 0x80 | len);  // Enable and read len bytes
    if (result != MPU9250_OK) return result;

    HAL_Delay(10);  // Wait for I2C transaction

    // Read from external sensor data registers
    return read_regs(MPU9250_REG_EXT_SENS_DATA_00, buf, len);
}

// DMP memory operations
static MPU9250_Error_t set_mem_bank(uint8_t bank) {
    return write_reg(MPU9250_REG_BANK_SEL, bank);
}

static MPU9250_Error_t set_mem_start_addr(uint8_t addr) {
    return write_reg(MPU9250_REG_MEM_START_ADDR, addr);
}

static MPU9250_Error_t write_mem(uint16_t addr, const uint8_t *data, uint16_t len) {
    if (!data || len == 0) return MPU9250_ERR_INVALID_PARAM;

    MPU9250_Error_t result;

    result = set_mem_bank(addr >> 8);
    if (result != MPU9250_OK) return result;

    result = set_mem_start_addr(addr & 0xFF);
    if (result != MPU9250_OK) return result;

    for (uint16_t i = 0; i < len; i++) {
        result = write_reg(MPU9250_REG_MEM_R_W, data[i]);
        if (result != MPU9250_OK) return result;
    }

    return MPU9250_OK;
}

static MPU9250_Error_t read_mem(uint16_t addr, uint8_t *data, uint16_t len) {
    if (!data || len == 0) return MPU9250_ERR_INVALID_PARAM;

    MPU9250_Error_t result;

    result = set_mem_bank(addr >> 8);
    if (result != MPU9250_OK) return result;

    result = set_mem_start_addr(addr & 0xFF);
    if (result != MPU9250_OK) return result;

    for (uint16_t i = 0; i < len; i++) {
        result = read_regs(MPU9250_REG_MEM_R_W, &data[i], 1);
        if (result != MPU9250_OK) return result;
    }

    return MPU9250_OK;
}

// Convert quaternion to Euler angles with proper singularity handling
static void quat_to_euler(const MPU9250_Quat_t *q, MPU9250_Euler_t *euler) {
    float test = q->x * q->y + q->z * q->w;

    if (test > 0.499f) {  // Singularity at north pole
        euler->yaw = 2.0f * atan2f(q->x, q->w) * 180.0f / M_PI;
        euler->pitch = 90.0f;
        euler->roll = 0.0f;
        return;
    }

    if (test < -0.499f) {  // Singularity at south pole
        euler->yaw = -2.0f * atan2f(q->x, q->w) * 180.0f / M_PI;
        euler->pitch = -90.0f;
        euler->roll = 0.0f;
        return;
    }

    float sqx = q->x * q->x;
    float sqy = q->y * q->y;
    float sqz = q->z * q->z;

    euler->yaw = atan2f(2.0f * q->y * q->w - 2.0f * q->x * q->z, 1.0f - 2.0f * sqy - 2.0f * sqz) * 180.0f / M_PI;
    euler->pitch = asinf(2.0f * test) * 180.0f / M_PI;
    euler->roll = atan2f(2.0f * q->x * q->w - 2.0f * q->y * q->z, 1.0f - 2.0f * sqx - 2.0f * sqz) * 180.0f / M_PI;
}

// Calculate gravity-compensated linear acceleration
static void calculate_linear_accel(const MPU9250_Quat_t *q, const MPU9250_Accel_t *accel, MPU9250_LinearAccel_t *linear_accel) {
    // Calculate gravity vector in body frame using quaternion
    float gx = 2.0f * (q->x * q->z - q->w * q->y);
    float gy = 2.0f * (q->w * q->x + q->y * q->z);
    float gz = q->w * q->w - q->x * q->x - q->y * q->y + q->z * q->z;

    // Remove gravity (assuming 1g = 9.81 m/s²)
    linear_accel->x = (accel->x - gx) * 9.81f;
    linear_accel->y = (accel->y - gy) * 9.81f;
    linear_accel->z = (accel->z - gz) * 9.81f;
}

// Public API Implementation
MPU9250_Error_t MPU9250_Init(MPU9250_Config_t *config) {
    if (!config || !config->spi_handle || !config->cs_port) {
        return MPU9250_ERR_INVALID_PARAM;
    }

    // Store configuration
    spi_h = config->spi_handle;
    cs_port = config->cs_port;
    cs_pin = config->cs_pin;
    sample_rate_hz = config->sample_rate;

    // Calculate scales
    switch (config->gyro_fsr) {
        case 250: gyro_scale = 250.0f / 32768.0f; break;
        case 500: gyro_scale = 500.0f / 32768.0f; break;
        case 1000: gyro_scale = 1000.0f / 32768.0f; break;
        case 2000: gyro_scale = 2000.0f / 32768.0f; break;
        default: return MPU9250_ERR_INVALID_PARAM;
    }

    switch (config->accel_fsr) {
        case 2: accel_scale = 2.0f / 32768.0f; break;
        case 4: accel_scale = 4.0f / 32768.0f; break;
        case 8: accel_scale = 8.0f / 32768.0f; break;
        case 16: accel_scale = 16.0f / 32768.0f; break;
        default: return MPU9250_ERR_INVALID_PARAM;
    }

    MPU9250_Error_t result;

    // Reset device
    result = MPU9250_Reset();
    if (result != MPU9250_OK) return result;

    // Verify WHO_AM_I
    uint8_t whoami;
    result = read_regs(MPU9250_REG_WHO_AM_I, &whoami, 1);
    if (result != MPU9250_OK) return result;
    if (whoami != 0x71 && whoami != 0x73) return MPU9250_ERR_WHOAMI;

    // Wake up device and set clock source
    result = write_reg(MPU9250_REG_PWR_MGMT_1, 0x01);  // Auto-select clock source
    if (result != MPU9250_OK) return result;
    HAL_Delay(100);

    // Configure gyroscope
    uint8_t gyro_config = 0;
    switch (config->gyro_fsr) {
        case 250: gyro_config = 0x00; break;
        case 500: gyro_config = 0x08; break;
        case 1000: gyro_config = 0x10; break;
        case 2000: gyro_config = 0x18; break;
    }
    result = write_reg(MPU9250_REG_GYRO_CONFIG, gyro_config);
    if (result != MPU9250_OK) return result;

    // Configure accelerometer
    uint8_t accel_config = 0;
    switch (config->accel_fsr) {
        case 2: accel_config = 0x00; break;
        case 4: accel_config = 0x08; break;
        case 8: accel_config = 0x10; break;
        case 16: accel_config = 0x18; break;
    }
    result = write_reg(MPU9250_REG_ACCEL_CONFIG, accel_config);
    if (result != MPU9250_OK) return result;

    // Configure accelerometer 2 (DLPF)
    result = write_reg(MPU9250_REG_ACCEL_CONFIG2, config->dlpf_cfg & 0x0F);
    if (result != MPU9250_OK) return result;

    // Configure DLPF
    result = write_reg(MPU9250_REG_CONFIG, config->dlpf_cfg & 0x07);
    if (result != MPU9250_OK) return result;

    // Set sample rate
    uint8_t div = (1000 / config->sample_rate) - 1;
    result = write_reg(MPU9250_REG_SMPLRT_DIV, div);
    if (result != MPU9250_OK) return result;

    // Configure interrupt pin for active high, push-pull, latch until read
    result = write_reg(MPU9250_REG_INT_PIN_CFG, 0x22);
    if (result != MPU9250_OK) return result;

    // Enable data ready interrupt
    result = write_reg(MPU9250_REG_INT_ENABLE, 0x01);
    if (result != MPU9250_OK) return result;

    // Initialize magnetometer
    // Enable I2C master mode
    result = write_reg(MPU9250_REG_USER_CTRL, 0x20);
    if (result != MPU9250_OK) return result;

    // Set I2C master clock to 400kHz
    result = write_reg(MPU9250_REG_I2C_MST_CTRL, 0x0D);
    if (result != MPU9250_OK) return result;

    // Reset AK8963
    result = write_ak8963(AK8963_REG_CNTL2, 0x01);
    if (result != MPU9250_OK) return result;
    HAL_Delay(10);

    // Check AK8963 WHO_AM_I
    uint8_t ak_whoami;
    result = read_ak8963(AK8963_REG_WIA, &ak_whoami, 1);
    if (result == MPU9250_OK && ak_whoami == 0x48) {
        // Configure AK8963 for continuous measurement mode 2 (16-bit, 100Hz)
        result = write_ak8963(AK8963_REG_CNTL1, 0x16);
        if (result != MPU9250_OK) return result;
    }

    // Perform calibrations if requested
    if (config->calibrate_gyro) {
        result = MPU9250_CalibrateGyro(calibration.gyro_bias);
        if (result != MPU9250_OK) return result;
    }

    if (config->calibrate_accel) {
        result = MPU9250_CalibrateAccel(calibration.accel_bias);
        if (result != MPU9250_OK) return result;
    }

    if (config->calibrate_mag) {
        result = MPU9250_CalibrateMag(calibration.mag_bias, calibration.mag_scale);
        if (result != MPU9250_OK) return result;
    }

    calibration.calibrated = 1;

    return MPU9250_OK;
}

MPU9250_Error_t MPU9250_LoadDMP(void) {
    if (dmp_firmware_size == 0) {
        return MPU9250_ERR_DMP_LOAD;
    }

    MPU9250_Error_t result;

    // Reset FIFO and DMP
    result = write_reg(MPU9250_REG_USER_CTRL, 0x0C);  // Reset FIFO and DMP
    if (result != MPU9250_OK) return result;
