// I2C read
uint8_t mpu6500_interface_iic_read(uint8_t addr, uint8_t reg, uint8_t *buf, uint16_t len) {
    addr = addr << 1; // Shift address for HAL (7-bit to 8-bit)
    if (HAL_I2C_Mem_Read(&hi2c1, addr, reg, 1, buf, len, 1000) == HAL_OK) {
        return 0; // Success
    }
    return 1; // Error
}

// I2C write
uint8_t mpu6500_interface_iic_write(uint8_t addr, uint8_t reg, uint8_t *buf, uint16_t len) {
    addr = addr << 1; // Shift address for HAL
    if (HAL_I2C_Mem_Write(&hi2c1, addr, reg, 1, buf, len, 1000) == HAL_OK) {
        return 0; // Success
    }
    return 1; // Error
}

