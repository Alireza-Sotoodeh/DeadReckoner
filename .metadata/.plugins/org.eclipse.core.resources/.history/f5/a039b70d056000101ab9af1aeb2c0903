/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();

  uint8_t res;

  mpu6500_interface_spi_init();
  mpu6500_interface_delay_ms(100);

  mpu6500_init(&g_mpu6500_handle);
  mpu6500_set_interface(&g_mpu6500_handle, MPU6500_INTERFACE_SPI);
  mpu6500_set_addr_pin(&g_mpu6500_handle, MPU6500_ADDRESS_AD0_LOW);

  res = mpu6500_set_accelerometer_range(&g_mpu6500_handle, MPU6500_ACCELEROMETER_RANGE_4G);
  res |= mpu6500_set_gyroscope_range(&g_mpu6500_handle, MPU6500_GYROSCOPE_RANGE_500DPS);
  res |= mpu6500_set_sample_rate_divider(&g_mpu6500_handle, 7);
  res |= mpu6500_set_low_pass_filter(&g_mpu6500_handle, MPU6500_LOW_PASS_FILTER_41_HZ);
  res |= mpu6500_accelerometer_calibration(&g_mpu6500_handle, 5000);
  res |= mpu6500_gyroscope_calibration(&g_mpu6500_handle, 5000);

  if (res != 0) {
      mpu6500_interface_debug_print("MPU6500: Configuration failed.\n");
      while (1);
  }

  float accel_g[3];
  float gyro_dps[3];
  float temperature;

  while (1)
  {
      res = mpu6500_read(&g_mpu6500_handle, accel_g, gyro_dps);
      if (res == 0) {
          mpu6500_interface_debug_print("Accel: X=%.2fg, Y=%.2fg, Z=%.2fg\n", accel_g[0], accel_g[1], accel_g[2]);
          mpu6500_interface_debug_print("Gyro:  X=%.2fdps, Y=%.2fdps, Z=%.2fdps\n", gyro_dps[0], gyro_dps[1], gyro_dps[2]);
      }
      res = mpu6500_read_temperature(&g_mpu6500_handle, &temperature);
      if (res == 0) {
          mpu6500_interface_debug_print("Temperature: %.2f C\n", temperature);
      }
      mpu6500_interface_delay_ms(1);
  }
}

/* USER CODE BEGIN 4 */
void mpu6500_interface_debug_print(const char *const fmt, ...)
{
    char buffer[256];
    va_list args;
    va_start(args, fmt);
    vsnprintf(buffer, sizeof(buffer), fmt, args);
    va_end(args);
    HAL_UART_Transmit(&huart1, (uint8_t *)buffer, strlen(buffer), 1000);
}
/* USER CODE END 4 */
