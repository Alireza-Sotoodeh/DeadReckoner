// SPI Deinit
uint8_t mpu9250_interface_spi_deinit(void) {
    HAL_SPI_DeInit(&hspi1);
    return 0;
}

// SPI Read (address is register, buf is data, len is length)
uint8_t mpu9250_interface_spi_read(uint8_t addr, uint8_t *buf, uint16_t len) {
    uint8_t tx_buf[1] = {addr | 0x80};  // Read bit set
    HAL_GPIO_WritePin(CS_PORT, CS_PIN, GPIO_PIN_RESET);  // CS low
    if (HAL_SPI_Transmit(&hspi1, tx_buf, 1, HAL_MAX_DELAY) != HAL_OK) return 1;
    if (HAL_SPI_Receive(&hspi1, buf, len, HAL_MAX_DELAY) != HAL_OK) return 1;
    HAL_GPIO_WritePin(CS_PORT, CS_PIN, GPIO_PIN_SET);  // CS high
    return 0;
}

// SPI Write
uint8_t mpu9250_interface_spi_write(uint8_t addr, uint8_t *buf, uint16_t len) {
    uint8_t tx_buf[1] = {addr & 0x7F};  // Write bit clear
    HAL_GPIO_WritePin(CS_PORT, CS_PIN, GPIO_PIN_RESET);
    if (HAL_SPI_Transmit(&hspi1, tx_buf, 1, HAL_MAX_DELAY) != HAL_OK) return 1;
    if (HAL_SPI_Transmit(&hspi1, buf, len, HAL_MAX_DELAY) != HAL_OK) return 1;
    HAL_GPIO_WritePin(CS_PORT, CS_PIN, GPIO_PIN_SET);
    return 0;
}

