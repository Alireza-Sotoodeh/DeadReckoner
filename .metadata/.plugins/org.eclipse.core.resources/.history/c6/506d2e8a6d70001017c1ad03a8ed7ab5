/**
 * @brief Receive callback for interrupts
 * @param type IRQ type
 */
static void receive_callback(uint8_t type)
{
  switch (type)
  {
    case MPU9250_INTERRUPT_DMP:
    {
      int32_t quat_raw[4];
      float quat[4];
      float pitch, roll, yaw;
      uint16_t len = 0;
      int16_t accel_raw[3], gyro_raw[3], mag_raw[3];
      float accel_g[3], gyro_dps[3], mag_gauss[3];

      // Read full DMP data (includes quat and Euler with mag fusion if enabled)
      if (mpu9250_dmp_read(&g_handle, accel_raw, accel_g, gyro_raw, gyro_dps, mag_raw, mag_gauss, quat, &pitch, &roll, &yaw, &len) == 0 && len > 0)
      {
        g_quat[0] = quat[0];
        g_quat[1] = quat[1];
        g_quat[2] = quat[2];
        g_quat[3] = quat[3];
        g_euler[0] = pitch;
        g_euler[1] = roll;
        g_euler[2] = yaw;
      }
      else
      {
        // Fallback to quat only
        if (mpu9250_dmp_get_6x_lp_quat(&g_handle, quat_raw, quat) == 0)
        {
          g_quat[0] = quat[0];
          g_quat[1] = quat[1];
          g_quat[2] = quat[2];
          g_quat[3] = quat[3];
        }
      }
      mpu9250_interface_debug_print("mpu9250: DMP data ready. Quaternion: %.2f %.2f %.2f %.2f Euler: %.2f %.2f %.2f", g_quat[0], g_quat[1], g_quat[2], g_quat[3], g_euler[0], g_euler[1], g_euler[2]);
      break;
    }
    case MPU9250_INTERRUPT_DATA_READY:
    {
      mpu9250_interface_debug_print("mpu9250: Data ready.");
      break;
    }
    case MPU9250_INTERRUPT_FIFO_OVERFLOW:
    {
      mpu9250_interface_debug_print("mpu9250: FIFO overflow.");
      break;
    }
    default:
    {
      break;
    }
  }
}

