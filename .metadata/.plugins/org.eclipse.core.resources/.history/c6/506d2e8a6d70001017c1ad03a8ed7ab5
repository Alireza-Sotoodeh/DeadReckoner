/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  uint8_t res;
  int32_t gyro_offset_raw[3];
  int32_t accel_offset_raw[3];
  int32_t gyro_bias[3];
  int32_t accel_bias[3] = {0, 0, 0};  // Default no bias for accel in basic setup
  int8_t gyro_orientation[9] = {1, 0, 0, 0, 1, 0, 0, 0, 1};
  uint8_t value;
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */

  /* Link interface functions */
  DRIVER_MPU9250_LINK_INIT(&g_handle, mpu9250_handle_t);
  DRIVER_MPU9250_LINK_SPI_INIT(&g_handle, mpu9250_interface_spi_init);
  DRIVER_MPU9250_LINK_SPI_DEINIT(&g_handle, mpu9250_interface_spi_deinit);
  DRIVER_MPU9250_LINK_SPI_READ(&g_handle, mpu9250_interface_spi_read);
  DRIVER_MPU9250_LINK_SPI_WRITE(&g_handle, mpu9250_interface_spi_write);
  DRIVER_MPU9250_LINK_DELAY_MS(&g_handle, mpu9250_interface_delay_ms);
  DRIVER_MPU9250_LINK_DEBUG_PRINT(&g_handle, mpu9250_interface_debug_print);
  DRIVER_MPU9250_LINK_RECEIVE_CALLBACK(&g_handle, receive_callback);

  /* Set SPI interface */
  res = mpu9250_set_interface(&g_handle, MPU9250_INTERFACE_SPI);
  if (res != 0) { while (1); }

  /* Set addr pin (ignored for SPI) */
  res = mpu9250_set_addr_pin(&g_handle, MPU9250_ADDRESS_AD0_LOW);
  if (res != 0) { while (1); }

  /* Initialize MPU9250 */
  res = mpu9250_init(&g_handle);
  if (res != 0) { while (1); }

  HAL_Delay(100);

  /* Disable sleep mode */
  res = mpu9250_set_sleep(&g_handle, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }

  /* Run self-test for offsets */
  res = mpu9250_self_test(&g_handle, gyro_offset_raw, accel_offset_raw);
  if (res != 0) { while (1); }

  /* Compute biases */
  gyro_bias[0] = -gyro_offset_raw[0];
  gyro_bias[1] = -gyro_offset_raw[1];
  gyro_bias[2] = -gyro_offset_raw[2];

  /* Disable I2C slave (since using SPI) */
  res = mpu9250_set_disable_iic_slave(&g_handle, MPU9250_BOOL_TRUE);
  if (res != 0) { while (1); }

  /* Set clock source */
  res = mpu9250_set_clock_source(&g_handle, MPU9250_CLOCK_SOURCE_PLL_ZGYRO);
  if (res != 0) { while (1); }

  /* Set sample rate divider for ~200Hz (1000 / (1+4) = 200Hz) */
  res = mpu9250_set_sample_rate_divider(&g_handle, 4);
  if (res != 0) { while (1); }

  /* Set accelerometer range */
  res = mpu9250_set_accelerometer_range(&g_handle, MPU9250_ACCELEROMETER_RANGE_2G);
  if (res != 0) { while (1); }

  /* Set gyroscope range */
  res = mpu9250_set_gyroscope_range(&g_handle, MPU9250_GYROSCOPE_RANGE_2000DPS);
  if (res != 0) { while (1); }

  /* Set low pass filter */
  res = mpu9250_set_low_pass_filter(&g_handle, MPU9250_LOW_PASS_FILTER_3);
  if (res != 0) { while (1); }

  /* Enable all sensors (disable standby) */
  res = mpu9250_set_standby_mode(&g_handle, MPU9250_SOURCE_ACC_X, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }
  res = mpu9250_set_standby_mode(&g_handle, MPU9250_SOURCE_ACC_Y, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }
  res = mpu9250_set_standby_mode(&g_handle, MPU9250_SOURCE_ACC_Z, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }
  res = mpu9250_set_standby_mode(&g_handle, MPU9250_SOURCE_GYRO_X, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }
  res = mpu9250_set_standby_mode(&g_handle, MPU9250_SOURCE_GYRO_Y, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }
  res = mpu9250_set_standby_mode(&g_handle, MPU9250_SOURCE_GYRO_Z, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }

  /* Initialize magnetometer for 9-axis fusion (bypass mode for config) */
  res = mpu9250_set_iic_bypass(&g_handle, MPU9250_BOOL_TRUE);
  if (res != 0) { while (1); }
  value = 0x01;  // Reset mag
  res = mpu9250_ak8963_write(&g_handle, 0x0B, &value, 1);
  if (res != 0) { while (1); }
  HAL_Delay(10);
  value = 0x16;  // 16-bit, 100Hz continuous mode
  res = mpu9250_ak8963_write(&g_handle, 0x0A, &value, 1);
  if (res != 0) { while (1); }
  res = mpu9250_set_iic_bypass(&g_handle, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }

  /* Set mag as I2C slave for DMP access (read 8 bytes: ST1 + 6 mag + ST2) */
  res = mpu9250_set_iic_master(&g_handle, MPU9250_BOOL_TRUE);
  if (res != 0) { while (1); }
  res = mpu9250_set_iic_slave_addr(&g_handle, 0, 0x0C);  // AK8963 addr
  if (res != 0) { while (1); }
  res = mpu9250_set_iic_slave_register(&g_handle, 0, 0x02);  // Start from ST1
  if (res != 0) { while (1); }
  res = mpu9250_set_iic_slave_write_mode(&g_handle, 0, MPU9250_IIC_SLAVE_READ);
  if (res != 0) { while (1); }
  res = mpu9250_set_iic_slave_len(&g_handle, 0, 8);  // 8 bytes
  if (res != 0) { while (1); }
  res = mpu9250_set_iic_slave_enable(&g_handle, 0, MPU9250_BOOL_TRUE);
  if (res != 0) { while (1); }
  res = mpu9250_set_iic_slave_fifo_enable(&g_handle, 0, MPU9250_BOOL_TRUE);
  if (res != 0) { while (1); }

  /* Load DMP firmware */
  res = mpu9250_dmp_load_firmware(&g_handle);
  if (res != 0) { while (1); }

  /* Set DMP orientation matrix */
  res = mpu9250_dmp_set_orientation(&g_handle, gyro_orientation);
  if (res != 0) { while (1); }

  /* Set DMP features for max accuracy (6x quat with gyro/accel/mag fusion via orient/pedometer) */
  res = mpu9250_dmp_set_feature(&g_handle, MPU9250_DMP_FEATURE_6X_QUAT | MPU9250_DMP_FEATURE_TAP | MPU9250_DMP_FEATURE_ORIENT | MPU9250_DMP_FEATURE_PEDOMETER | MPU9250_DMP_FEATURE_GYRO_CAL | MPU9250_DMP_FEATURE_SEND_RAW_ACCEL | MPU9250_DMP_FEATURE_SEND_CAL_GYRO);
  if (res != 0) { while (1); }

  /* Set DMP FIFO rate */
  res = mpu9250_dmp_set_fifo_rate(&g_handle, 100);
  if (res != 0) { while (1); }

  /* Set biases */
  res = mpu9250_dmp_set_gyro_bias(&g_handle, gyro_bias);
  if (res != 0) { while (1); }
  res = mpu9250_dmp_set_accel_bias(&g_handle, accel_bias);
  if (res != 0) { while (1); }

  /* Set DMP interrupt mode */
  res = mpu9250_dmp_set_interrupt_mode(&g_handle, MPU9250_DMP_INTERRUPT_MODE_CONTINUOUS);
  if (res != 0) { while (1); }

  /* Set callbacks for tap and orient */
  res = mpu9250_dmp_set_tap_callback(&g_handle, tap_callback);
  if (res != 0) { while (1); }
  res = mpu9250_dmp_set_orient_callback(&g_handle, orient_callback);
  if (res != 0) { while (1); }

  /* Enable DMP interrupt */
  res = mpu9250_set_interrupt(&g_handle, MPU9250_INTERRUPT_DMP, MPU9250_BOOL_TRUE);
  if (res != 0) { while (1); }

  /* Enable FIFO */
  res = mpu9250_set_fifo(&g_handle, MPU9250_BOOL_TRUE);
  if (res != 0) { while (1); }

  /* Reset FIFO */
  res = mpu9250_set_fifo_reset(&g_handle, MPU9250_BOOL_TRUE);
  if (res != 0) { while (1); }
  HAL_Delay(50);
  res = mpu9250_set_fifo_reset(&g_handle, MPU9250_BOOL_FALSE);
  if (res != 0) { while (1); }

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // Polling fallback (comment out once IRQ is set up in stm32f4xx_it.c)
    mpu9250_irq_handler(&g_handle);
    HAL_Delay(10);
  }
  /* USER CODE END 3 */
}

