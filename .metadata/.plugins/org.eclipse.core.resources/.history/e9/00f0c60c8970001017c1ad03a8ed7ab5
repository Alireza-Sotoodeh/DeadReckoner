/* USER CODE BEGIN 4 */
void mpu9250_dmp_callback(uint8_t type)
{
    if (type == MPU9250_INTERRUPT_DMP)
    {
        gs_flag = 1;
    }
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == INT_Pin)
    {
        if (gs_dmp_inited != 0)
        {
            if (mpu9250_irq_handler(&gs_handle) != 0)
            {
                mpu9250_interface_debug_print("mpu9250: irq handler failed.");
            }
        }
    }
}
