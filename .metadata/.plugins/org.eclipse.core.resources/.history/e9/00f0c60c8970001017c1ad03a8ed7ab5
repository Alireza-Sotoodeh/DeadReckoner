/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_SPI1_Init();
  /* USER CODE BEGIN 2 */

  uint8_t res;
  uint8_t reg;
  int32_t gyro_offset_raw[3];
  int32_t accel_offset_raw[3];
  int8_t gyro_orientation[9] = {1, 0, 0,
                                0, 1, 0,
                                0, 0, 1};

  /* Link interface functions */
  DRIVER_MPU9250_LINK_INIT(&gs_handle, mpu9250_handle_t);
  DRIVER_MPU9250_LINK_IIC_INIT(&gs_handle, mpu9250_interface_iic_init);
  DRIVER_MPU9250_LINK_IIC_DEINIT(&gs_handle, mpu9250_interface_iic_deinit);
  DRIVER_MPU9250_LINK_IIC_READ(&gs_handle, mpu9250_interface_iic_read);
  DRIVER_MPU9250_LINK_IIC_WRITE(&gs_handle, mpu9250_interface_iic_write);
  DRIVER_MPU9250_LINK_SPI_INIT(&gs_handle, mpu9250_interface_spi_init);
  DRIVER_MPU9250_LINK_SPI_DEINIT(&gs_handle, mpu9250_interface_spi_deinit);
  DRIVER_MPU9250_LINK_SPI_READ(&gs_handle, mpu9250_interface_spi_read);
  DRIVER_MPU9250_LINK_SPI_WRITE(&gs_handle, mpu9250_interface_spi_write);
  DRIVER_MPU9250_LINK_DELAY_MS(&gs_handle, mpu9250_interface_delay_ms);
  DRIVER_MPU9250_LINK_DEBUG_PRINT(&gs_handle, mpu9250_interface_debug_print);
  DRIVER_MPU9250_LINK_RECEIVE_CALLBACK(&gs_handle, mpu9250_dmp_callback);

  /* Set interface to SPI */
  res = mpu9250_set_interface(&gs_handle, MPU9250_INTERFACE_SPI);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set interface failed.");
      while(1);
  }

  /* Set address (for SPI, this is typically LOW) */
  res = mpu9250_set_addr_pin(&gs_handle, MPU9250_ADDRESS_AD0_LOW);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set addr pin failed.");
      while(1);
  }

  /* Initialize MPU9250 */
  res = mpu9250_init(&gs_handle);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: init failed.");
      while(1);
  }

  /* Delay for stability */
  mpu9250_interface_delay_ms(100);

  /* Read WHO_AM_I to verify communication */
  res = mpu9250_get_reg(&gs_handle, MPU9250_REG_WHO_AM_I, &reg);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: get who am i failed.");
      while(1);
  }
  mpu9250_interface_debug_print("mpu9250: who am i = 0x%02X", reg);

  /* Disable sleep mode */
  res = mpu9250_set_sleep(&gs_handle, MPU9250_BOOL_FALSE);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set sleep failed.");
      while(1);
  }

  /* For SPI, disable I2C interface */
  res = mpu9250_set_disable_iic_slave(&gs_handle, MPU9250_BOOL_TRUE);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set disable iic slave failed.");
      while(1);
  }

  /* Run self test */
  res = mpu9250_self_test(&gs_handle, gyro_offset_raw, accel_offset_raw);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: self test failed.");
      while(1);
  }
  mpu9250_interface_debug_print("mpu9250: self test passed.");

  /* Configure for DMP */
  res = mpu9250_set_clock_source(&gs_handle, MPU9250_CLOCK_SOURCE_PLL);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set clock source failed.");
      while(1);
  }

  /* Set sample rate divider for 200Hz (1000Hz / 5) */
  res = mpu9250_set_sample_rate_divider(&gs_handle, 4);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set sample rate divider failed.");
      while(1);
  }

  /* Set ranges */
  res = mpu9250_set_accelerometer_range(&gs_handle, MPU9250_ACCELEROMETER_RANGE_2G);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set accelerometer range failed.");
      while(1);
  }

  res = mpu9250_set_gyroscope_range(&gs_handle, MPU9250_GYROSCOPE_RANGE_2000DPS);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set gyroscope range failed.");
      while(1);
  }

  /* Load DMP firmware */
  res = mpu9250_load_dmp_firmware(&gs_handle);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: load dmp firmware failed.");
      while(1);
  }

  /* Set DMP orientation */
  res = mpu9250_dmp_set_orientation(&gs_handle, gyro_orientation);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: dmp set orientation failed.");
      while(1);
  }

  /* Enable DMP features */
  res = mpu9250_dmp_set_feature(&gs_handle,
                                MPU9250_DMP_FEATURE_6X_QUAT |
                                MPU9250_DMP_FEATURE_SEND_RAW_ACCEL |
                                MPU9250_DMP_FEATURE_SEND_RAW_GYRO);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: dmp set feature failed.");
      while(1);
  }

  /* Set DMP output rate (200Hz / 4 = 50Hz) */
  res = mpu9250_dmp_set_fifo_rate(&gs_handle, 4);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: dmp set fifo rate failed.");
      while(1);
  }

  /* Enable DMP interrupt */
  res = mpu9250_set_interrupt(&gs_handle, MPU9250_INTERRUPT_DMP, MPU9250_BOOL_TRUE);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set interrupt failed.");
      while(1);
  }

  /* Set interrupt pin to active high, push-pull */
  res = mpu9250_set_interrupt_level(&gs_handle, MPU9250_PIN_LEVEL_HIGH);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set interrupt level failed.");
      while(1);
  }

  /* Enable DMP */
  res = mpu9250_dmp_set_enable(&gs_handle, MPU9250_BOOL_TRUE);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: dmp set enable failed.");
      while(1);
  }

  /* Reset FIFO */
  res = mpu9250_fifo_reset(&gs_handle);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: fifo reset failed.");
      while(1);
  }

  /* Enable FIFO */
  res = mpu9250_set_fifo(&gs_handle, MPU9250_BOOL_TRUE);
  if (res != 0)
  {
      mpu9250_interface_debug_print("mpu9250: set fifo failed.");
      while(1);
  }

  gs_dmp_inited = 1;
  mpu9250_interface_debug_print("mpu9250: dmp init success!");

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  if (gs_flag != 0)
	      {
	          gs_flag = 0;

	          uint16_t len;
	          uint8_t buf[128];
	          int16_t accel_raw[3];
	          int16_t gyro_raw[3];
	          int32_t quat[4];
	          float accel_g[3];
	          float gyro_dps[3];
	          float pitch, roll, yaw;

	          /* Get FIFO length */
	          res = mpu9250_get_fifo_count(&gs_handle, &len);
	          if (res == 0)
	          {
	              /* Read FIFO */
	              if (len > 28)  /* DMP packet size */
	              {
	                  res = mpu9250_fifo_read(&gs_handle, buf, len);
	                  if (res == 0)
	                  {
	                      /* Parse DMP data */
	                      res = mpu9250_dmp_decode(&gs_handle, buf, quat,accel_raw, gyro_raw);
	                      if (res == 0)
	                      {
	                          /* Convert to real units */
	                          mpu9250_accelerometer_convert_to_g(&gs_handle,accel_raw,accel_g);
	                          mpu9250_gyroscope_convert_to_dps(&gs_handle,gyro_raw,gyro_dps);

	                          /* Calculate Euler angles from quaternion */
	                          mpu9250_dmp_quaternion_to_euler(&gs_handle,quat,&pitch, &roll, &yaw);

	                          /* Use data for navigation */
	                          mpu9250_interface_debug_print("P:%.2f R:%.2f Y:%.2f", pitch, roll, yaw);
	                      }
	                  }
	              }
	          }
	      }

	      HAL_Delay(10);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

