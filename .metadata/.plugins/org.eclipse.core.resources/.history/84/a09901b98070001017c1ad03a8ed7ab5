/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_SPI1_Init();
  /* USER CODE BEGIN 2 */

  // MPU9250 setup for maximum accuracy
  mpu9250_handle_t handle;
  mpu9250_info_t info;
  uint8_t res;

  mpu9250_info(&info);  // Optional: gets chip info

  handle.interface = MPU9250_INTERFACE_SPI;
  res = mpu9250_init(&handle);
  if (res != 0) {
    // Error handling: print via UART and loop
    char buf[50];
    sprintf(buf, "MPU init failed: %d\r
", res);
    HAL_UART_Transmit(&huart1, (uint8_t*)buf, strlen(buf), HAL_MAX_DELAY);
    while (1);
  }

  // Configure for high accuracy
  mpu9250_set_clock_source(&handle, MPU9250_CLOCK_SOURCE_PLL_GYROSCOPE_X_AXIS);  // Stable clock
  mpu9250_set_accelerometer_range(&handle, MPU9250_ACCELEROMETER_RANGE_2G);  // High res
  mpu9250_set_gyroscope_range(&handle, MPU9250_GYROSCOPE_RANGE_250DPS);  // High res
  mpu9250_set_magnetometer_mode(&handle, MPU9250_MAGNETOMETER_MODE_CONTINUOUS_100HZ);  // Fast mag updates
  mpu9250_set_magnetometer_resolution(&handle, MPU9250_MAGNETOMETER_RESOLUTION_16_BITS);
  mpu9250_set_low_pass_filter(&handle, MPU9250_LOW_PASS_FILTER_5);  // ~5Hz cutoff for noise reduction
  mpu9250_set_sample_rate_divider(&handle, 0);  // Max sample rate (1 kHz)

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    int16_t acc_raw[3], gyro_raw[3], mag_raw[3];
    float acc_g[3], gyro_dps[3], mag_ut[3];
    float temp_c;

    // Read data
    mpu9250_read_accelerometer(&handle, acc_raw, acc_g);
    mpu9250_read_gyroscope(&handle, gyro_raw, gyro_dps);
    mpu9250_read_magnetometer(&handle, mag_raw, mag_ut);
    int16_t temp_raw;
    mpu9250_read_temperature(&handle, &temp_raw, &temp_c);

    // Print via UART (example format; adjust as needed)
    char buf[256];
    sprintf(buf, "Acc: %.3f %.3f %.3f g | Gyro: %.3f %.3f %.3f dps | Mag: %.3f %.3f %.3f uT | Temp: %.2f C\r",acc_g[0], acc_g[1], acc_g[2],gyro_dps[0], gyro_dps[1], gyro_dps[2],mag_ut[0], mag_ut[1], mag_ut[2],temp_c);
    HAL_UART_Transmit(&huart1, (uint8_t*)buf, strlen(buf), HAL_MAX_DELAY);

    HAL_Delay(100);  // 10 Hz read rate; adjust for your needs

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

