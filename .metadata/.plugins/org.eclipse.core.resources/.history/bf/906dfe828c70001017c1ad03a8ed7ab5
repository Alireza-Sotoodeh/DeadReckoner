/* USER CODE BEGIN 0 */
void receive_callback(uint8_t type) {
    if (type == 2) {  // DMP data ready (check lib docs for types)
        data_ready_flag = 1;  // Signal main loop to read
    }
}

void tap_callback(uint8_t count, uint8_t direction) {
    // Optional: Use for step detection in navigation
    char buf[50];
    snprintf(buf, sizeof(buf), "Tap: %d times, direction %d\r", count, direction);
    HAL_UART_Transmit(&huart1, (uint8_t*)buf, strlen(buf), HAL_MAX_DELAY);
}

void orient_callback(uint8_t orientation) {
    // Use for detecting turns/motion in indoor nav
    char buf[50];
    snprintf(buf, sizeof(buf), "Orientation changed: %d\r", orientation);
    HAL_UART_Transmit(&huart1, (uint8_t*)buf, strlen(buf), HAL_MAX_DELAY);
}

