/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	static volatile bool mpu_data_ready = false;
	/* MPU-9250 DMP callbacks (we can ignore tap/orient for now) */
	static void mpu_receive_callback(uint8_t type)
	{
	    /* type tells you which interrupt fired: MOTION, FIFO_OVERFLOW, DMP, etc. */
	    UNUSED(type);
	    mpu_data_ready = true;
	}

	static void mpu_tap_callback(uint8_t count, uint8_t direction)
	{
	    /* not used in basic nav */
	    UNUSED(count);
	    UNUSED(direction);
	}

	static void mpu_orient_callback(uint8_t orientation)
	{
	    /* not used in basic nav */
	    UNUSED(orientation);
	}

	/* EXTI handler for MPU_INT pin */
	void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
	{
	    if (GPIO_Pin == MPU9250_INT_PIN) {
	        /* call the driver IRQ handler */
	        mpu9250_dmp_irq_handler();
	    }
	}
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  volatile int16_t accel_raw[3];
  volatile float   accel_g[3];
  volatile int16_t gyro_raw[3];
  volatile float   gyro_dps[3];
  volatile int32_t quat[4];
  volatile float   pitch, roll, yaw;
  volatile uint16_t length;
  /* Initialize the DMP */
     if (mpu9250_dmp_init(MPU9250_INTERFACE_SPI,
                          MPU9250_ADDRESS_0,            // AD0 pulled to GND
                          mpu_receive_callback,
                          mpu_tap_callback,
                          mpu_orient_callback) != 0) {
         Error_Handler();  // Initialization failed
     }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  if (mpu9250_dmp_read_all(&accel_raw, &accel_g,
	                                       &gyro_raw,  &gyro_dps,
	                                       &quat,
	                                       &pitch, &roll, &yaw,
	                                       &length) == 0) {
		  printf("P:%.2f  R:%.2f  Y:%.2f", pitch, roll, yaw);
		              }
		          }



    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

