// Function to print debug messages via UART
void debug_print(const char *format, ...)
{
    va_list args;
    va_start(args, format);
    vsnprintf(debug_buffer, sizeof(debug_buffer), format, args);
    va_end(args);
    HAL_UART_Transmit(&huart1, (uint8_t *)debug_buffer, strlen(debug_buffer), 1000);
}

// Interrupt handler for MPU6500 data-ready interrupt
void EXTI0_IRQHandler(void)
{
    if (__HAL_GPIO_EXTI_GET_IT(EXT_Pin) != RESET)
    {
        __HAL_GPIO_EXTI_CLEAR_IT(EXT_Pin);
        mpu6500_interface_receive_callback(MPU6500_INTERRUPT_DATA_READY);
    }
}
