/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  // Initialize MPU6500 interface
  if (mpu6500_interface_init() != 0)
  {
      debug_print("MPU6500: Interface initialization failed.\n");
      while (1);
  }

  // Initialize MPU6500 handle
  if (mpu6500_init(&mpu6500_handle) != 0)
  {
      debug_print("MPU6500: Initialization failed.\n");
      while (1);
  }

  // Configure MPU6500 for high accuracy
  // Set sample rate to 1 kHz (SMPLRT_DIV = 0, assuming 8 kHz internal clock)
  if (mpu6500_set_sample_rate(&mpu6500_handle, 0) != 0)
  {
      debug_print("MPU6500: Failed to set sample rate.\n");
      while (1);
  }

  // Set accelerometer full-scale range to ±4g for better sensitivity
  if (mpu6500_set_accelerometer_range(&mpu6500_handle, MPU6500_ACCELEROMETER_RANGE_4G) != 0)
  {
      debug_print("MPU6500: Failed to set accelerometer range.\n");
      while (1);
  }

  // Set gyroscope full-scale range to ±1000°/s for navigation
  if (mpu6500_set_gyroscope_range(&mpu6500_handle, MPU6500_GYROSCOPE_RANGE_1000DPS) != 0)
  {
      debug_print("MPU6500: Failed to set gyroscope range.\n");
      while (1);
  }

  // Set low-pass filter to 41 Hz for noise reduction
  if (mpu6500_set_low_pass_filter(&mpu6500_handle, MPU6500_DLPF_41HZ) != 0)
  {
      debug_print("MPU6500: Failed to set low-pass filter.\n");
      while (1);
  }

  // Enable DMP for processed orientation data
  if (mpu6500_dmp_init(&mpu6500_handle, MPU6500_DMP_FEATURE_6X_QUAT | MPU6500_DMP_FEATURE_GYRO_CAL) != 0)
  {
      debug_print("MPU6500: DMP initialization failed.\n");
      while (1);
  }

  // Calibrate gyroscope (takes ~8 seconds)
  if (mpu6500_dmp_set_gyro_calibrate(&mpu6500_handle, MPU6500_BOOL_TRUE) != 0)
  {
      debug_print("MPU6500: Gyroscope calibration failed.\n");
      while (1);
  }

  // Enable data-ready interrupt
  if (mpu6500_set_interrupt(&mpu6500_handle, MPU6500_INTERRUPT_DATA_READY, MPU6500_BOOL_TRUE) != 0)
  {
      debug_print("MPU6500: Failed to enable data-ready interrupt.\n");
      while (1);
  }

  // Variables for sensor data
  float accel_g[3], gyro_dps[3];
  float quaternion[4], euler[3];
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // Check for data-ready interrupt (handled in mpu6500_interface_receive_callback)
    // Alternatively, poll FIFO for DMP data
    uint16_t fifo_count;
    if (mpu6500_dmp_get_fifo_count(&mpu6500_handle, &fifo_count) == 0 && fifo_count >= 42)
    {
        // Read DMP data (quaternions)
        if (mpu6500_dmp_read(&mpu6500_handle, quaternion, NULL, NULL, NULL) == 0)
        {
            // Convert quaternion to Euler angles for navigation
            mpu6500_dmp_get_euler_angle(quaternion, euler);
            debug_print("Euler Angles: Roll=%.2f, Pitch=%.2f, Yaw=%.2f\n",
                        euler[0], euler[1], euler[2]);
        }

        // Read raw accelerometer and gyroscope data
        if (mpu6500_read_accelerometer(&mpu6500_handle, accel_g, accel_g + 1, accel_g + 2) == 0 &&
            mpu6500_read_gyroscope(&mpu6500_handle, gyro_dps, gyro_dps + 1, gyro_dps + 2) == 0)
        {
            debug_print("Accel: X=%.2f g, Y=%.2f g, Z=%.2f g\n",
                        accel_g[0], accel_g[1], accel_g[2]);
            debug_print("Gyro: X=%.2f dps, Y=%.2f dps, Z=%.2f dps\n",
                        gyro_dps[0], gyro_dps[1], gyro_dps[2]);
        }

        // TODO: Integrate with micro-SD for data logging
        // TODO: Send data via ESP-01S WiFi or HC-05 Bluetooth
    }

    HAL_Delay(10); // Adjust delay based on desired update rate
  }
  /* USER CODE END 3 */
}

