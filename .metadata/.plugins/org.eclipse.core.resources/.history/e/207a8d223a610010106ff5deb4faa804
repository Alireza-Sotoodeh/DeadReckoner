// Callback for MPU6500 data ready interrupt
void mpu6500_receive_callback(uint8_t type)
{
    if (type == MPU6500_INTERRUPT_DATA_READY)
    {
        uint16_t len = 1;
        int16_t accel_raw[3];
        int16_t gyro_raw[3];

        // Read DMP data (includes orientation)
        if (mpu6500_dmp_read_all(&accel_raw, &accel_g,
                                &gyro_raw, &gyro_dps,
                                &quat,
                                &pitch, &roll, &yaw,
                                &len) == 0)
        {
            // Update navigation estimates
            update_navigation_estimates();

            // Optionally send data via UART
            send_data_via_uart();
        }
    }
}

// Tap detection callback (not used for navigation but included for completeness)
void mpu6500_tap_callback(uint8_t count, uint8_t direction)
{
    char buffer[50];
    snprintf(buffer, sizeof(buffer), "Tap detected: count=%d, dir=%d\r\n", count, direction);
    HAL_UART_Transmit(&huart1, (uint8_t *)buffer, strlen(buffer), HAL_MAX_DELAY);
}

// Orientation callback (for detecting device orientation changes)
void mpu6500_orient_callback(uint8_t orientation)
{
    char buffer[50];
    snprintf(buffer, sizeof(buffer), "Orientation changed: %d\r\n", orientation);
    HAL_UART_Transmit(&huart1, (uint8_t *)buffer, strlen(buffer), HAL_MAX_DELAY);
}

// Simple navigation update (dead reckoning)
void update_navigation_estimates(void)
{
    static uint32_t last_time = 0;
    uint32_t current_time = HAL_GetTick();
    float dt = (current_time - last_time) / 1000.0f; // Convert to seconds

    if (last_time != 0 && dt > 0)
    {
        // Simple integration of acceleration to get velocity
        // Note: This is very basic and will drift quickly - you'll need more sophisticated filtering
        for (int i = 0; i < 3; i++)
        {
            // Subtract gravity component (using pitch/roll)
            float gravity_component = 0;
            if (i == 0) gravity_component = sin(roll * M_PI / 180.0f);
            if (i == 1) gravity_component = -sin(pitch * M_PI / 180.0f);
            if (i == 2) gravity_component = -1.0f; // Assuming Z is up

            float linear_accel = accel_g[i] - gravity_component;

            velocity[i] += linear_accel * 9.81f * dt; // Convert g to m/s²
            position[i] += velocity[i] * dt;
        }
    }

    last_time = current_time;
}

// Send data via UART for debugging
void send_data_via_uart(void)
{
    static uint32_t last_send_time = 0;
    uint32_t current_time = HAL_GetTick();

    // Only send every 100ms to avoid flooding the UART
    if (current_time - last_send_time >= 100)
    {
        char buffer[256];
        snprintf(buffer, sizeof(buffer),
                "Pitch: %.2f, Roll: %.2f, Yaw: %.2f | "
                "Accel: %.2f, %.2f, %.2f g | "
                "Gyro: %.2f, %.2f, %.2f dps | "
                "Pos: %.2f, %.2f, %.2f m\r\n",
                pitch, roll, yaw,
                accel_g[0], accel_g[1], accel_g[2],
                gyro_dps[0], gyro_dps[1], gyro_dps[2],
                position[0], position[1], position[2]);

        HAL_UART_Transmit(&huart1, (uint8_t *)buffer, strlen(buffer), HAL_MAX_DELAY);
        last_send_time = current_time;
    }
}
