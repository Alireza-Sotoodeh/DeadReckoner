#ifndef MPU9250_H
#define MPU9250_H

#include "stm32f4xx_hal.h"

extern SPI_HandleTypeDef hspi1;  // From main.c or stm32f4xx_hal_msp.c

#define MPU_CS_GPIO_PORT GPIOA
#define MPU_CS_GPIO_PIN GPIO_PIN_4
#define MPU_TIMEOUT 100

#define MPU9250_ADDR 0x68  // Not used in SPI, but for reference
#define WHO_AM_I 0x75
#define WHO_AM_I_VAL 0x71  // Expected value for MPU9250

// Registers (partial list)
#define PWR_MGMT_1 0x6B
#define CONFIG 0x1A
#define GYRO_CONFIG 0x1B
#define ACCEL_CONFIG 0x1C
#define INT_ENABLE 0x38
#define USER_CTRL 0x6A
#define FIFO_EN 0x23
#define FIFO_COUNT_H 0x72
#define FIFO_R_W 0x74

// DMP related
#define BANK_SEL 0x6D
#define MEM_START_ADDR 0x6E
#define MEM_R_W 0x6F
#define DMP_CFG_1 0x70
#define DMP_CFG_2 0x71

// Function prototypes
HAL_StatusTypeDef MPU9250_Init(void);
HAL_StatusTypeDef MPU9250_Read_Reg(uint8_t reg, uint8_t *data, uint16_t len);
HAL_StatusTypeDef MPU9250_Write_Reg(uint8_t reg, uint8_t *data, uint16_t len);
HAL_StatusTypeDef MPU9250_Load_DMP_Firmware(void);
HAL_StatusTypeDef MPU9250_Enable_DMP(void);
void MPU9250_Read_DMP_Data(float *quat);  // Example for quaternion read

#endif
