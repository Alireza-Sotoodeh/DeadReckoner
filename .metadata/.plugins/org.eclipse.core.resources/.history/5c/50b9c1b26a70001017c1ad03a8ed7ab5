/**
 * @brief      interface spi bus read
 * @param[in]  reg register address
 * @param[out] *buf pointer to a data buffer
 * @param[in]  len length of data buffer
 * @return     status code
 *             - 0 success
 *             - 1 read failed
 * @note       MPU9250 SPI read: set MSB of reg to 1 (0x80 | reg)
 */
uint8_t mpu9250_interface_spi_read(uint8_t reg, uint8_t *buf, uint16_t len)
{
    uint8_t tx_reg = reg | 0x80;  /* Set read flag */

    HAL_GPIO_WritePin(MPU_CS_PORT, MPU_CS_PIN, GPIO_PIN_RESET);  /* CS low */

    if (HAL_SPI_Transmit(&hspi1, &tx_reg, 1, HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU_CS_PORT, MPU_CS_PIN, GPIO_PIN_SET);  /* CS high */
        return 1;
    }

    if (HAL_SPI_Receive(&hspi1, buf, len, HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU_CS_PORT, MPU_CS_PIN, GPIO_PIN_SET);  /* CS high */
        return 1;
    }

    HAL_GPIO_WritePin(MPU_CS_PORT, MPU_CS_PIN, GPIO_PIN_SET);  /* CS high */

    return 0;
}

/**
 * @brief     interface spi bus write
 * @param[in] reg register address
 * @param[in] *buf pointer to a data buffer
 * @param[in] len length of data buffer
 * @return    status code
 *            - 0 success
 *            - 1 write failed
 * @note      MPU9250 SPI write: set MSB of reg to 0 (0x7F & reg)
 */
uint8_t mpu9250_interface_spi_write(uint8_t reg, uint8_t *buf, uint16_t len)
{
    uint8_t tx_reg = reg & 0x7F;  /* Set write flag */

    HAL_GPIO_WritePin(MPU_CS_PORT, MPU_CS_PIN, GPIO_PIN_RESET);  /* CS low */

    if (HAL_SPI_Transmit(&hspi1, &tx_reg, 1, HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU_CS_PORT, MPU_CS_PIN, GPIO_PIN_SET);  /* CS high */
        return 1;
    }

    if (HAL_SPI_Transmit(&hspi1, buf, len, HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU_CS_PORT, MPU_CS_PIN, GPIO_PIN_SET);  /* CS high */
        return 1;
    }

    HAL_GPIO_WritePin(MPU_CS_PORT, MPU_CS_PIN, GPIO_PIN_SET);  /* CS high */

    return 0;
}

