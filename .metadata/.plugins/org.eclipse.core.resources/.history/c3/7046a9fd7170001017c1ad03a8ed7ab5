void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == GPIO_PIN_3)        // your INT line is PA3
    {
        mpu9250_irq_flag = 1;
        (void)mpu9250_dmp_irq_handler();  // clear the interrupt in the DMP
    }
}
