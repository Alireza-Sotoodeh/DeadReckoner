/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  // Initialize MPU6500 interface
  if (mpu6500_interface_init() != 0)
  {
      debug_print("MPU6500: Interface initialization failed.\n");
      while (1);
  }

  // Initialize MPU6500 handle
  if (mpu6500_init(&mpu6500_handle) != 0)
  {
      debug_print("MPU6500: Initialization failed.\n");
      while (1);
  }

  // Configure MPU6500 for high accuracy
  // Set sample rate to 1 kHz (SMPLRT_DIV = 0, assuming 8 kHz internal clock)
  if (mpu6500_set_sample_rate_divider(&mpu6500_handle, 0) != 0)
  {
      debug_print("MPU6500: Failed to set sample rate.\n");
      while (1);
  }

  // Set accelerometer full-scale range to ±4g
  if (mpu6500_set_accelerometer_range(&mpu6500_handle, MPU6500_ACCELEROMETER_RANGE_4G) != 0)
  {
      debug_print("MPU6500: Failed to set accelerometer range.\n");
      while (1);
  }

  // Set gyroscope full-scale range to ±1000°/s
  if (mpu6500_set_gyroscope_range(&mpu6500_handle, MPU6500_GYROSCOPE_RANGE_1000DPS) != 0)
  {
      debug_print("MPU6500: Failed to set gyroscope range.\n");
      while (1);
  }

  // Set low-pass filter to 41 Hz
  if (mpu6500_set_dlpf(&mpu6500_handle, MPU6500_DLPF_41_HZ) != 0)
  {
      debug_print("MPU6500: Failed to set low-pass filter.\n");
      while (1);
  }

  // Enable data-ready interrupt
  if (mpu6500_set_interrupt(&mpu6500_handle, MPU6500_INTERRUPT_DATA_READY, MPU6500_BOOL_TRUE) != 0)
  {
      debug_print("MPU6500: Failed to enable data-ready interrupt.\n");
      while (1);
  }

  // Calibrate gyroscope (device must be stationary)
  debug_print("Calibrating gyroscope, keep device stationary...\n");
  calibrate_gyroscope(gyro_bias);
  debug_print("Calibration complete: Bias X=%.2f, Y=%.2f, Z=%.2f dps\n",
              gyro_bias[0], gyro_bias[1], gyro_bias[2]);

  // Variables for sensor data and timing
  float accel_g[3], gyro_dps[3], euler[3];
  uint32_t last_time = HAL_GetTick();
  float dt = 0.001f; // 1 kHz = 1 ms
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // Read raw accelerometer and gyroscope data
    if (mpu6500_get_accelerometer(&mpu6500_handle, accel_g, accel_g + 1, accel_g + 2) == 0 &&
        mpu6500_get_gyroscope(&mpu6500_handle, gyro_dps, gyro_dps + 1, gyro_dps + 2) == 0)
    {
        // Apply gyro bias correction
        gyro_dps[0] -= gyro_bias[0];
        gyro_dps[1] -= gyro_bias[1];
        gyro_dps[2] -= gyro_bias[2];

        // Update Madgwick filter for orientation
        madgwick_update(gyro_dps[0] * DEG_TO_RAD, gyro_dps[1] * DEG_TO_RAD, gyro_dps[2] * DEG_TO_RAD,
                        accel_g[0], accel_g[1], accel_g[2], dt);

        // Convert quaternion to Euler angles
        quaternion_to_euler(q, euler);

        // Print data
        debug_print("Accel: X=%.2f g, Y=%.2f g, Z=%.2f g\n",
                    accel_g[0], accel_g[1], accel_g[2]);
        debug_print("Gyro: X=%.2f dps, Y=%.2f dps, Z=%.2f dps\n",
                    gyro_dps[0], gyro_dps[1], gyro_dps[2]);
        debug_print("Euler: Roll=%.2f, Pitch=%.2f, Yaw=%.2f deg\n",
                    euler[0] * RAD_TO_DEG, euler[1] * RAD_TO_DEG, euler[2] * RAD_TO_DEG);

        // TODO: Log data to micro-SD card (use FatFS)
        // TODO: Send data via ESP-01S WiFi (AT commands) or HC-05 Bluetooth (UART)
    }

    // Update timing
    uint32_t current_time = HAL_GetTick();
    dt = (current_time - last_time) / 1000.0f; // Convert ms to seconds
    last_time = current_time;

    HAL_Delay(1); // 1 ms delay for ~1 kHz update rate
  }
  /* USER CODE END 3 */
}

