// Simple Madgwick filter for sensor fusion
void madgwick_update(float gx, float gy, float gz, float ax, float ay, float az, float dt)
{
    float norm;
    float s[4], q_dot[4];
    float f[3], h[3];

    // Normalize accelerometer data
    norm = sqrtf(ax * ax + ay * ay + az * az);
    if (norm == 0.0f) return;
    ax /= norm;
    ay /= norm;
    az /= norm;

    // Gradient descent algorithm corrective step
    f[0] = 2.0f * (q[1] * q[3] - q[0] * q[2]) - ax;
    f[1] = 2.0f * (q[0] * q[1] + q[2] * q[3]) - ay;
    f[2] = 2.0f * (0.5f - q[1] * q[1] - q[2] * q[2]) - az;

    s[0] = -2.0f * q[2] * f[0] + 2.0f * q[1] * f[1];
    s[1] = 2.0f * q[3] * f[0] - 2.0f * q[0] * f[1] - 4.0f * q[1] * f[2];
    s[2] = -2.0f * q[0] * f[0] + 2.0f * q[3] * f[1] - 4.0f * q[2] * f[2];
    s[3] = 2.0f * q[1] * f[0] + 2.0f * q[0] * f[1];

    // Integrate rate of change of quaternion
    q_dot[0] = 0.5f * (-q[1] * gx - q[2] * gy - q[3] * gz) - MADGWICK_BETA * s[0];
    q_dot[1] = 0.5f * (q[0] * gx + q[2] * gz - q[3] * gy) - MADGWICK_BETA * s[1];
    q_dot[2] = 0.5f * (q[0] * gy - q[1] * gz + q[3] * gx) - MADGWICK_BETA * s[2];
    q_dot[3] = 0.5f * (q[0] * gz + q[1] * gy - q[2] * gx) - MADGWICK_BETA * s[3];

    // Update quaternion
    q[0] += q_dot[0] * dt;
    q[1] += q_dot[1] * dt;
    q[2] += q_dot[2] * dt;
    q[3] += q_dot[3] * dt;

    // Normalize quaternion
    norm = sqrtf(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
    if (norm == 0.0f) return;
    q[0] /= norm;
    q[1] /= norm;
    q[2] /= norm;
    q[3] /= norm;
}

// Convert quaternion to Euler angles (roll, pitch, yaw)
void quaternion_to_euler(float q[4], float euler[3])
{
    // Roll (x-axis rotation)
    float sinr_cosp = 2.0f * (q[0] * q[1] + q[2] * q[3]);
    float cosr_cosp = 1.0f - 2.0f * (q[1] * q[1] + q[2] * q[2]);
    euler[0] = atan2f(sinr_cosp, cosr_cosp);

    // Pitch (y-axis rotation)
    float sinp = 2.0f * (q[0] * q[2] - q[3] * q[1]);
    if (fabsf(sinp) >= 1.0f)
        euler[1] = copysignf(M_PI / 2.0f, sinp); // Handle 90-degree cases
    else
        euler[1] = asinf(sinp);

    // Yaw (z-axis rotation)
    float siny_cosp = 2.0f * (q[0] * q[3] + q[1] * q[2]);
    float cosy_cosp = 1.0f - 2.0f * (q[2] * q[2] + q[3] * q[3]);
    euler[2] = atan2f(siny_cosp, cosy_cosp);
}

// Calibrate gyroscope by averaging readings while stationary
void calibrate_gyroscope(float bias[3])
{
    float gyro_dps[3];
    float sum[3] = {0.0f, 0.0f, 0.0f};
    const int samples = 1000;

    for (int i = 0; i < samples; i++)
    {
        if (mpu6500_get_gyroscope(&mpu6500_handle, gyro_dps, gyro_dps + 1, gyro_dps + 2) == 0)
        {
            sum[0] += gyro_dps[0];
            sum[1] += gyro_dps[1];
            sum[2] += gyro_dps[2];
        }
        HAL_Delay(1);
    }

    bias[0] = sum[0] / samples;
    bias[1] = sum[1] / samples;
    bias[2] = sum[2] / samples;
}

