/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  // Initialize MPU6500 in SPI mode
  uint8_t res; // Result variable for error checking
  mpu6500_address_t addr = MPU6500_ADDRESS_AD0_LOW; // MPU6500 I2C address (not used in SPI mode, but required by library)

  res = mpu6500_basic_init(MPU6500_INTERFACE_SPI, addr);
  if (res != 0) {
      // Handle initialization error
      while (1) {
          mpu6500_interface_debug_print("MPU6500: Initialization failed.\n");
          HAL_Delay(1000);
      }
  }

  // Configure MPU6500 for high accuracy and speed
  // Set accelerometer full-scale range to ±4g for navigation
  res = mpu6500_set_accelerometer_range(&g_mpu6500_handle, MPU6500_ACCELEROMETER_RANGE_4G);
  if (res != 0) {
      mpu6500_interface_debug_print("MPU6500: Failed to set accelerometer range.\n");
  }

  // Set gyroscope full-scale range to ±500 dps for navigation
  res = mpu6500_set_gyroscope_range(&g_mpu6500_handle, MPU6500_GYROSCOPE_RANGE_500DPS);
  if (res != 0) {
      mpu6500_interface_debug_print("MPU6500: Failed to set gyroscope range.\n");
  }

  // Set sample rate to 1 kHz (gyroscope output rate is 8 kHz, so divider = 7)
  res = mpu6500_set_sample_rate(&g_mpu6500_handle, 8000 / (1 + 7)); // Sample Rate = 8000 / (1 + SMPLRT_DIV)
  if (res != 0) {
      mpu6500_interface_debug_print("MPU6500: Failed to set sample rate.\n");
  }

  // Enable Digital Low-Pass Filter (DLPF) at 41 Hz to reduce noise
  res = mpu6500_set_dlpf(&g_mpu6500_handle, MPU6500_DLPF_41HZ);
  if (res != 0) {
      mpu6500_interface_debug_print("MPU6500: Failed to set DLPF.\n");
  }

  // Perform accelerometer and gyroscope calibration (run for 5 seconds each)
  res = mpu6500_accelerometer_calibration(&g_mpu6500_handle, 5000);
  if (res != 0) {
      mpu6500_interface_debug_print("MPU6500: Accelerometer calibration failed.\n");
  }

  res = mpu6500_gyroscope_calibration(&g_mpu6500_handle, 5000);
  if (res != 0) {
      mpu6500_interface_debug_print("MPU6500: Gyroscope calibration failed.\n");
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  float accel_g[3]; // Accelerometer data in g (x, y, z)
  float gyro_dps[3]; // Gyroscope data in degrees per second (x, y, z)
  float temperature; // Temperature in Celsius

  while (1)
  {
      // Read accelerometer and gyroscope data
      res = mpu6500_basic_read(accel_g, gyro_dps);
      if (res != 0) {
          mpu6500_interface_debug_print("MPU6500: Failed to read sensor data.\n");
      } else {
          // Print accelerometer data (x, y, z in g)
          mpu6500_interface_debug_print("MPU6500: Accel X: %.2f g, Y: %.2f g, Z: %.2f g\n",
                                       accel_g[0], accel_g[1], accel_g[2]);
          // Print gyroscope data (x, y, z in degrees per second)
          mpu6500_interface_debug_print("MPU6500: Gyro X: %.2f dps, Y: %.2f dps, Z: %.2f dps\n",
                                       gyro_dps[0], gyro_dps[1], gyro_dps[2]);
      }

      // Read temperature (optional for navigation, but useful for monitoring)
      res = mpu6500_basic_read_temperature(&temperature);
      if (res != 0) {
          mpu6500_interface_debug_print("MPU6500: Failed to read temperature.\n");
      } else {
          mpu6500_interface_debug_print("MPU6500: Temperature: %.2f C\n", temperature);
      }

      // Delay to control data reading rate (e.g., 1 ms for 1 kHz)
      mpu6500_interface_delay_ms(1);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

