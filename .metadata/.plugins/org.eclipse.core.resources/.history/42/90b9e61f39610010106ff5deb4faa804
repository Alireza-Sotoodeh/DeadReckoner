/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  uint8_t res;
  int16_t accel_raw[DATA_BUFFER_SIZE][3];
  float accel_g[DATA_BUFFER_SIZE][3];
  int16_t gyro_raw[DATA_BUFFER_SIZE][3];
  float gyro_dps[DATA_BUFFER_SIZE][3];
  int32_t quat[DATA_BUFFER_SIZE][4];
  float pitch, roll, yaw;
  uint16_t len = DATA_BUFFER_SIZE;

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART1_UART_Init();

  /* USER CODE BEGIN 2 */
  /* Initialize MPU6500 in DMP mode */
  res = mpu6500_dmp_init(MPU6500_INTERFACE_SPI, MPU6500_ADDRESS_AD0_LOW,
                         mpu6500_interface_receive_callback,
                         mpu6500_dmp_tap_callback,
                         mpu6500_dmp_orient_callback);
  if (res != 0)
  {
      snprintf(debug_buffer, sizeof(debug_buffer), "MPU6500 DMP init failed.\n");
      HAL_UART_Transmit(&huart1, (uint8_t *)debug_buffer, strlen(debug_buffer), 1000);
      Error_Handler();
  }
  else
  {
      snprintf(debug_buffer, sizeof(debug_buffer), "MPU6500 DMP initialized successfully.\n");
      HAL_UART_Transmit(&huart1, (uint8_t *)debug_buffer, strlen(debug_buffer), 1000);
  }

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* Read DMP data */
    res = mpu6500_dmp_read_all(accel_raw, accel_g, gyro_raw, gyro_dps, quat, &pitch, &roll, &yaw, &len);
    if (res == 0 && len > 0)
    {
        /* Output the latest data (index 0) */
        snprintf(debug_buffer, sizeof(debug_buffer),
                 "Accel (g): X=%.2f, Y=%.2f, Z=%.2f | Gyro (dps): X=%.2f, Y=%.2f, Z=%.2f | Pitch=%.2f, Roll=%.2f, Yaw=%.2f\n",
                 accel_g[0][0], accel_g[0][1], accel_g[0][2],
                 gyro_dps[0][0], gyro_dps[0][1], gyro_dps[0][2],
                 pitch, roll, yaw);
        HAL_UART_Transmit(&huart1, (uint8_t *)debug_buffer, strlen(debug_buffer), 1000);
    }
    else
    {
        snprintf(debug_buffer, sizeof(debug_buffer), "Failed to read DMP data or no data available.\n");
        HAL_UART_Transmit(&huart1, (uint8_t *)debug_buffer, strlen(debug_buffer), 1000);
    }

    /* Delay to avoid overwhelming the UART */
    HAL_Delay(100);

    /* USER CODE END WHILE */
    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

