// SPI and UART handles defined in main.c
extern SPI_HandleTypeDef hspi1;
extern UART_HandleTypeDef huart1;

// GPIO pin definitions for Chip Select (CS)
#define MPU6500_CS_PORT GPIOA
#define MPU6500_CS_PIN  GPIO_PIN_4

/**
 * @brief  Interface initialization
 * @note   Initializes SPI peripheral and CS GPIO for MPU6500
 * @retval 0 on success, 1 on failure
 */
uint8_t mpu6500_interface_init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    // Ensure GPIOA clock is enabled
    __HAL_RCC_GPIOA_CLK_ENABLE();

    // Initialize CS pin
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);
    GPIO_InitStruct.Pin = MPU6500_CS_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(MPU6500_CS_PORT, &GPIO_InitStruct);

    // Check if SPI handle is valid
    if (hspi1.Instance == NULL)
    {
        mpu6500_interface_debug_print("mpu6500: SPI handle not initialized.\n");
        return 1;
    }

    // SPI is initialized by MX_SPI1_Init in main.c
    return 0;
}

/**
 * @brief  Interface deinitialization
 * @note   Deinitializes SPI peripheral and CS GPIO (optional)
 * @retval 0 on success, 1 on failure
 */
uint8_t mpu6500_interface_deinit(void)
{
    // Optional: Deinitialize SPI and CS pin if needed
    // HAL_SPI_DeInit(&hspi1);
    // HAL_GPIO_DeInit(MPU6500_CS_PORT, MPU6500_CS_PIN);
    return 0;
}

/**
 * @brief     Interface SPI bus write
 * @param[in] addr is the register address
 * @param[in] *pbuf points to a data buffer
 * @param[in] len is the length of the data buffer
 * @note      Implements efficient SPI write operation
 * @retval    0 on success, 1 on failure
 */
uint8_t mpu6500_interface_spi_write(uint8_t addr, uint8_t *pbuf, uint16_t len)
{
    // Check buffer length
    if (len > 255)
    {
        mpu6500_interface_debug_print("mpu6500: SPI write length exceeds 255 bytes.\n");
        return 1;
    }

    // Prepare address with write bit (MSB = 0)
    uint8_t addr_buf = addr & 0x7F;

    // Pull CS low
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_RESET);

    // Write address
    if (HAL_SPI_Transmit(&hspi1, &addr_buf, 1, 10) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);
        mpu6500_interface_debug_print("mpu6500: SPI write address failed.\n");
        return 1;
    }

    // Write data
    if (HAL_SPI_Transmit(&hspi1, pbuf, len, 10) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);
        mpu6500_interface_debug_print("mpu6500: SPI write data failed.\n");
        return 1;
    }

    // Pull CS high
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);
    return 0;
}

/**
 * @brief     Interface SPI bus read
 * @param[in] addr is the register address
 * @param[out] *pbuf points to a data buffer
 * @param[in] len is the length of the data buffer
 * @note      Implements efficient SPI read operation
 * @retval    0 on success, 1 on failure
 */
uint8_t mpu6500_interface_spi_read(uint8_t addr, uint8_t *pbuf, uint16_t len)
{
    // Check buffer length
    if (len > 255)
    {
        mpu6500_interface_debug_print("mpu6500: SPI read length exceeds 255 bytes.\n");
        return 1;
    }

    // Prepare address with read bit (MSB = 1)
    uint8_t addr_buf = addr | 0x80;

    // Pull CS low
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_RESET);

    // Write address
    if (HAL_SPI_Transmit(&hspi1, &addr_buf, 1, 10) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);
        mpu6500_interface_debug_print("mpu6500: SPI read address failed.\n");
        return 1;
    }

    // Read data
    if (HAL_SPI_Receive(&hspi1, pbuf, len, 10) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);
        mpu6500_interface_debug_print("mpu6500: SPI read data failed.\n");
        return 1;
    }

    // Pull CS high
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);
    return 0;
}

