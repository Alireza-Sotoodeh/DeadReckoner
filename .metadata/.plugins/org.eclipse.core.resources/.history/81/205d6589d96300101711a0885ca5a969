/**
 * @brief     Interface SPI bus write
 * @param[in] addr is the register address
 * @param[in] *pbuf points to a data buffer
 * @param[in] len is the length of the data buffer
 * @note      Implements SPI write operation for MPU6500
 * @retval    0 on success, 1 on failure
 */
uint8_t mpu6500_interface_spi_write(uint8_t addr, uint8_t *pbuf, uint16_t len)
{
    uint8_t tx_buffer[256]; // Buffer for SPI transmit data (max 256 bytes)
    uint8_t rx_buffer[256]; // Buffer for SPI receive data (dummy bytes)

    // Ensure the buffer length is reasonable
    if (len > 255) {
        return 1; // Return error if length exceeds buffer size
    }

    // Prepare the transmit buffer: first byte is the register address with write bit (MSB = 0)
    tx_buffer[0] = addr & 0x7F; // Clear MSB for write operation
    for (uint16_t i = 0; i < len; i++) {
        tx_buffer[i + 1] = pbuf[i]; // Copy data to transmit buffer
    }

    // Pull CS low to start SPI transaction
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_RESET);

    // Perform SPI transmit (receive is dummy data)
    HAL_StatusTypeDef status = HAL_SPI_TransmitReceive(&hspi1, tx_buffer, rx_buffer, len + 1, 1000);

    // Pull CS high to end SPI transaction
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);

    // Check for SPI errors
    if (status != HAL_OK) {
        return 1; // Return error on SPI failure
    }

    return 0; // Return success
}

/**
 * @brief     Interface SPI bus read
 * @param[in] addr is the register address
 * @param[out] *pbuf points to a data buffer
 * @param[in] len is the length of the data buffer
 * @note      Implements SPI read operation for MPU6500
 * @retval    0 on success, 1 on failure
 */
uint8_t mpu6500_interface_spi_read(uint8_t addr, uint8_t *pbuf, uint16_t len)
{
    uint8_t tx_buffer[256]; // Buffer for SPI transmit data (address + dummy bytes)
    uint8_t rx_buffer[256]; // Buffer for SPI receive data

    // Ensure the buffer length is reasonable
    if (len > 255) {
        return 1; // Return error if length exceeds buffer size
    }

    // Prepare the transmit buffer: first byte is the register address with read bit (MSB = 1)
    tx_buffer[0] = addr | 0x80; // Set MSB for read operation
    for (uint16_t i = 0; i < len; i++) {
        tx_buffer[i + 1] = 0x00; // Dummy bytes for reading
    }

    // Pull CS low to start SPI transaction
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_RESET);

    // Perform SPI transmit/receive (receive buffer contains data)
    HAL_StatusTypeDef status = HAL_SPI_TransmitReceive(&hspi1, tx_buffer, rx_buffer, len + 1, 1000);

    // Pull CS high to end SPI transaction
    HAL_GPIO_WritePin(MPU6500_CS_PORT, MPU6500_CS_PIN, GPIO_PIN_SET);

    // Check for SPI errors
    if (status != HAL_OK) {
        return 1; // Return error on SPI failure
    }

    // Copy received data (skip first byte, which is dummy)
    for (uint16_t i = 0; i < len; i++) {
        pbuf[i] = rx_buffer[i + 1];
    }

    return 0; // Return success
}

