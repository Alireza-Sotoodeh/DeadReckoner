/**
 * @brief  interface spi bus init
 * @return status code
 *         - 0 success
 *         - 1 spi init failed
 * @note   SPI speed (10 MHz) is set in CubeMX via prescaler (e.g., for 84 MHz clock, prescaler 8 gives ~10.5 MHz).
 *         CubeMX handles HAL_SPI_Init; this function assumes it's already called in main.
 */
uint8_t mpu9250_interface_spi_init(void)
{
    /* Set CS pin high (idle) */
    HAL_GPIO_WritePin(MPU9250_CS_PORT, MPU9250_CS_PIN, GPIO_PIN_SET);
    
    return 0;  /* Success; actual init done by CubeMX/MX_SPI1_Init() */
}

/**
 * @brief  interface spi bus deinit
 * @return status code
