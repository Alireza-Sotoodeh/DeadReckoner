/* Extern handles from main.c */
extern SPI_HandleTypeDef hspi1;
extern UART_HandleTypeDef huart1; // If you enabled UART for debug

/**
 * @brief  interface spi bus init
 */
uint8_t mpu9250_interface_spi_init(void)
{
    // HAL_SPI_Init is already called by main() generated by CubeIDE.
    // We just need to make sure the CS pin is high (inactive) initially.
    HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_SET); // Use the labels from CubeIDE
    return 0;
}

/**
 * @brief  interface spi bus deinit
 */
uint8_t mpu9250_interface_spi_deinit(void)
{
    // You can leave this as is or implement if needed
    if (HAL_SPI_DeInit(&hspi1) != HAL_OK)
    {
        return 1;
    }
    return 0;
}

/**
 * @brief      interface spi bus read
 */
uint8_t mpu9250_interface_spi_read(uint8_t reg, uint8_t *buf, uint16_t len)
{
    uint8_t reg_addr = reg | 0x80; // Set MSB for read operation

    // 1. Assert CS (pull low)
    HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_RESET);

    // 2. Send the register address we want to read from
    if (HAL_SPI_Transmit(&hspi1, &reg_addr, 1, HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_SET); // De-assert CS on failure
        return 1;
    }

    // 3. Receive the data
    if (HAL_SPI_Receive(&hspi1, buf, len, HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_SET); // De-assert CS on failure
        return 1;
    }

    // 4. De-assert CS (pull high)
    HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_SET);
    
    return 0;
}

/**
 * @brief     interface spi bus write
 */
uint8_t mpu9250_interface_spi_write(uint8_t reg, uint8_t *buf, uint16_t len)
{
    uint8_t reg_addr = reg & 0x7F; // Clear MSB for write operation

    // 1. Assert CS (pull low)
    HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_RESET);

    // 2. Send the register address we want to write to
    if (HAL_SPI_Transmit(&hspi1, &reg_addr, 1, HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_SET); // De-assert CS on failure
        return 1;
    }

    // 3. Transmit the data
    if (HAL_SPI_Transmit(&hspi1, buf, len, HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_SET); // De-assert CS on failure
        return 1;
    }

    // 4. De-assert CS (pull high)
    HAL_GPIO_WritePin(MPU_CS_GPIO_Port, MPU_CS_Pin, GPIO_PIN_SET);

    return 0;
}

/**
 * @brief     interface delay ms
 */
void mpu9250_interface_delay_ms(uint32_t ms)
{
    HAL_Delay(ms);
}

/**
 * @brief     interface print format data
 */
void mpu9250_interface_debug_print(const char *const fmt, ...)
{
    char buf[256];
    va_list args;
    va_start(args, fmt);
    vsnprintf(buf, sizeof(buf), fmt, args);
    va_end(args);

    HAL_UART_Transmit(&huart1, (uint8_t *)buf, strlen(buf), HAL_MAX_DELAY);
}

